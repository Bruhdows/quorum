<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>quorum status</title>
	<style>
		:root {
			--bg: #0a0e1a;
			--panel: #0d1220;
			--border: #1b2333;
			--text: #e8ecf4;
			--muted: #7c879c;
			--green: #22c55e;
			--red: #ef4444;
			--gray: #3a4255;
			--accent: #34d399;
		}
		* { box-sizing: border-box; }
		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		}
		header {
			border-bottom: 1px solid var(--border);
			padding: 20px 32px;
			display: flex;
			align-items: center;
			gap: 12px;
		}
		header .logo { font-size: 24px; }
		header h1 { font-size: 20px; margin: 0; font-weight: 700; }
		main { max-width: 1200px; margin: 0 auto; padding: 32px; }
		h2.title { font-size: 32px; margin: 0 0 4px; }
		p.subtitle { color: var(--muted); margin: 0 0 24px; }
		.controls {
			display: flex;
			gap: 12px;
			border: 1px solid var(--border);
			background: var(--panel);
			border-radius: 10px;
			padding: 14px 16px;
			margin-bottom: 24px;
			flex-wrap: wrap;
		}
		.controls input, .controls select {
			background: var(--bg);
			border: 1px solid var(--border);
			color: var(--text);
			border-radius: 8px;
			padding: 8px 12px;
			font-size: 14px;
		}
		.controls input { flex: 1; min-width: 200px; }
		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
			gap: 16px;
		}
		.card {
			border: 1px solid var(--border);
			background: var(--panel);
			border-radius: 10px;
			padding: 20px;
		}
		.card-top { display: flex; justify-content: space-between; align-items: flex-start; }
		.card h3 { margin: 0 0 4px; font-size: 17px; }
		.card .target { color: var(--muted); font-size: 13px; margin: 0; }
		.pill {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			font-size: 12px;
			font-weight: 600;
			border-radius: 999px;
			padding: 4px 10px;
			white-space: nowrap;
		}
		.pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
		.pill.up { color: var(--green); background: rgba(34,197,94,0.12); }
		.pill.down { color: var(--red); background: rgba(239,68,68,0.12); }
		.pill.unknown { color: var(--muted); background: rgba(124,135,156,0.12); }
		.latency-row { display: flex; justify-content: flex-end; font-size: 12px; color: var(--muted); margin-top: 12px; }
		.bars { display: flex; gap: 2px; margin-top: 6px; height: 32px; align-items: flex-end; }
		.bars .bar { flex: 1; height: 100%; border-radius: 2px; background: var(--gray); }
		.bars .bar.up { background: var(--green); }
		.bars .bar.down { background: var(--red); }
		.time-row { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 6px; }
		footer { text-align: center; color: var(--muted); padding: 24px; border-top: 1px solid var(--border); font-size: 13px; }
		footer a { color: var(--accent); text-decoration: none; }
		.empty { color: var(--muted); text-align: center; padding: 48px; }
	</style>
</head>
<body>
	<header>
		<span class="logo">🟢</span>
		<h1>Status</h1>
	</header>
	<main>
		<h2 class="title">Health Dashboard</h2>
		<p class="subtitle">Monitor the health of your endpoints in real-time</p>

		<div class="controls">
			<input id="search" type="text" placeholder="Search endpoints..." />
			<select id="sort">
				<option value="name">Sort by: Name</option>
				<option value="status">Sort by: Status</option>
				<option value="uptime">Sort by: Uptime</option>
			</select>
		</div>

		<div id="content"><p class="empty">Loading…</p></div>
	</main>
	<footer>Powered by <a href="https://github.com/Bruhdows/quorum" target="_blank" rel="noopener">quorum</a></footer>

	<script src="/scripts/status.js" defer></script>
</body>
</html>
