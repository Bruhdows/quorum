---
import App from '../components/App.jsx';
import '../styles/global.css';

// Defaults for the tab and link previews. The hub swaps these for the
// configured site branding when it serves the page (see patchIndexHead in
// internal/server), so keep the literals in sync with the Go side.
const defaultTitle = 'quorum';
const defaultDescription = 'Live health of every monitored endpoint, checked by quorum from several machines.';
---
<!doctype html>
<html lang="en" class="dark">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content={defaultDescription} />
	<meta property="og:type" content="website" />
	<meta property="og:title" content={defaultTitle} />
	<meta property="og:description" content={defaultDescription} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={defaultTitle} />
	<meta name="twitter:description" content={defaultDescription} />
	<title>{defaultTitle}</title>
	<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='6' fill='%2310b981'/%3E%3C/svg%3E" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
	<script is:inline>
		// Settle the theme before first paint. Nobody wants a dark flash,
		// or the reverse.
		(() => {
			let theme;
			try { theme = localStorage.getItem('quorum:theme'); } catch {}
			const dark = theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.classList.toggle('dark', dark);
			// On load there is nothing to fade, so native chrome matches straight away.
			if (dark) document.documentElement.setAttribute('data-scheme', 'dark');
		})();
	</script>
</head>
<body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
	<App client:load />

	<!-- Pushed to the bottom by `flex-1` on <main>, so a short page still fills
	     the viewport. It scrolls with the content rather than floating over it. -->
	<footer class="mt-auto border-t border-border px-6 py-4 text-center text-sm text-muted">
		Powered by <a class="text-success transition-opacity hover:opacity-80" href="https://github.com/Bruhdows/quorum" target="_blank" rel="noopener">quorum</a>
	</footer>
</body>
</html>
