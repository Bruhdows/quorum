# Copy this to .env and fill in real values before running docker compose.
# Generate both with: openssl rand -hex 32
AGENT_TOKEN=
# Hex only (0-9a-f): compose interpolates this into DATABASE_URL, so
# characters like @ / : ? # & will break the connection string. Stick to
# `openssl rand -hex` output and you avoid URL-encoding entirely.
POSTGRES_PASSWORD=

# Optional: Discord webhook URL for down/recovery alerts. Leave empty to
# disable alerting. Can also live in services.yaml under alerts.
DISCORD_WEBHOOK_URL=
